    {
      "tag": "DMM",
      "type": "selector",
      "outbounds": [
        "节点选择",
        "香港",
        "日本",
        "新加坡",
        "美国",
        "其他",
        "直连",
        "{all}"
      ]
    },
    {
      "tag": "香港",
      "type": "urltest",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "include",
          "keywords": [
            "🇭🇰|HK|hk|香港|HongKong"
          ]
        }
      ]
    },
    {
      "tag": "日本",
      "type": "urltest",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "include",
          "keywords": [
            "🇯🇵|JP|jp|日本|Japan"
          ]
        }
      ]
    },
    {
      "tag": "新加坡",
      "type": "urltest",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "include",
          "keywords": [
            "🇸🇬|SG|sg|新加坡|Singapore"
          ]
        }
      ]
    },
    {
      "tag": "美国",
      "type": "urltest",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "include",
          "keywords": [
            "🇺🇸|US|us|美国|United States"
          ]
        }
      ]
    },
    {
      "tag": "其他",
      "type": "urltest",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "exclude",
          "keywords": [
            "香港|日本|新加坡|美国"
          ]
        }
      ]
    },
    {
      "tag": "直连",
      "type": "direct",
      "domain_resolver": "china-dns"
    }
  ],
  "http_clients": [
    {
      "tag": "直连下载",
      "detour": "直连"
    }
  ],
  "route": {
    "final": "节点选择",
    "auto_detect_interface": true,
    "default_domain_resolver": "china-dns",
