      "outbounds": [
        "节点选择",
        "香港",
        "日本",
        "新加坡",
        "美国",
        "其他",
        "直连",
        "{all}"
      ]
    },
    {
      "tag": "Google",
      "type": "selector",
      "outbounds": [
        "节点选择",
        "香港",
        "日本",
        "新加坡",
        "美国",
        "其他",
        "直连",
        "{all}"
