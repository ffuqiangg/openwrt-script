{
  "log": {
    "disabled": false,
    "level": "error",
    "output": "/var/log/sing-box.log",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "main-dns",
        "type": "https",
        "server": "dns.google",
        "domain_resolver": "china-dns",
        "detour": "节点选择"
      },
      {
        "tag": "china-dns",
        "type": "h3",
        "server": "223.5.5.5",
        "detour": "直连"
      }
    ],
    "rules": [
      {
        "clash_mode": "global",
        "server": "main-dns"
      },
      {
        "clash_mode": "direct",
        "server": "china-dns"
      },
      {
        "domain_suffix": [
          "services.googleapis.cn",
          "xn--ngstr-lra8j.com"
        ],
        "server": "main-dns"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geosite-bilibili",
          "geosite-microsoft@cn",
          "geosite-apple@cn"
        ],
        "server": "china-dns"
      },
      {
        "action": "evaluate",
        "server": "china-dns"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "rule_set": "geosite-noncn",
            "invert": true
          },
          {
            "match_response": true,
            "rule_set": "geoip-cn"
          }
        ],
        "server": "china-dns"
      }
    ],
    "final": "main-dns",
    "strategy": "ipv4_only",
    "optimistic": true
  },
  "experimental": {
    "clash_api": {
      "external_controller": "0.0.0.0:9900",
      "external_ui": "ui",
      "external_ui_download_url": "https://gh-proxy.com/github.com/Zephyruso/zashboard/releases/latest/download/dist.zip",
      "external_ui_download_detour": "直连",
      "secret": "ffuqiangg",
      "default_mode": "rule"
    },
    "cache_file": {
      "enabled": true,
      "store_dns": true
    }
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.0/30"
      ],
      "auto_route": true,
      "auto_redirect": true,
      "strict_route": true
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "::",
      "listen_port": 2881
    },
    {
      "type": "socks",
      "tag": "socks-in",
      "listen": "::",
      "listen_port": 2882,
      "detour": "直连"
    },
    {
      "type": "redirect",
      "tag": "redirect-in",
      "listen": "::",
      "listen_port": 2883
    },
    {
      "type": "tproxy",
      "tag": "tproxy-in",
      "listen": "::",
      "listen_port": 2884
    },
    {
      "type": "direct",
      "tag": "dns-in",
      "listen": "::",
      "listen_port": 2885
    }
  ],
  "outbounds": [
    {
      "tag": "节点选择",
      "type": "selector",
      "outbounds": [
        "自动选择",
        "香港",
        "日本",
        "新加坡",
        "美国",
        "其他",
        "直连",
        "{all}"
